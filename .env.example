# Copy to .env for non-secret settings. Never put real keys in this file.
# Secrets (like LLM_API_KEY) go in the OS keychain: `uv run argos secrets set LLM_API_KEY`.
# An environment variable with the same name as a secret overrides the keychain.

# ARGOS_LLM_PROVIDER=groq
# ARGOS_LLM_MODEL=openai/gpt-oss-120b
